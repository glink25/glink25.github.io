        {
          "styles": {
            "code": true
          },
          "text": "expensetype:expensecategory",
          "type": "text"
        },
        {
          "styles": {},
          "text": "分类。可填 ID 或名称",
          "type": "text"
        },
        {
          "styles": {
            "code": true
          },
          "text": "category:餐饮tag",
          "type": "text"
        },
        {
          "styles": {},
          "text": "标签。可填 ID 或名称，多个标签用 OR / AND 自行组合",
          "type": "text"
