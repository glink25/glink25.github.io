    {
      "children": [],
      "content": [
        {
          "styles": {},
          "text": "字段含义示例",
          "type": "text"
        },
        {
          "styles": {
            "code": true
          },
          "text": "type",
          "type": "text"
        },
        {
          "styles": {},
          "text": "账单类型，",
          "type": "text"
        },
        {
          "styles": {
            "code": true
          },
          "text": "income",
