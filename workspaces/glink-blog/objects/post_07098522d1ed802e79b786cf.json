        {
          "styles": {
            "code": true
          },
          "text": "tag:旅行creator",
          "type": "text"
        },
        {
          "styles": {},
          "text": " / ",
          "type": "text"
        },
        {
          "styles": {
            "code": true
          },
          "text": "user",
          "type": "text"
        },
        {
          "styles": {},
          "text": "记账人",
          "type": "text"
        },
        {
          "styles": {
            "code": true
          },
          "text": "creator:张三currency",
          "type": "text"
        },
        {
          "styles": {},
          "text": "币种代码",
          "type": "text"
        },
        {
          "styles": {
            "code": true
          },
          "text": "currency:USDamount",
          "type": "text"
