        {
          "styles": {},
          "text": "、",
          "type": "text"
        },
        {
          "styles": {
            "code": true
          },
          "text": "amount:[50 TO 200]time",
          "type": "text"
        },
        {
          "styles": {},
          "text": "账单发生时间，支持 ISO 日期",
          "type": "text"
        },
        {
          "styles": {
            "code": true
          },
          "text": "time:>=2025-01-01recent",
          "type": "text"
        },
        {
          "styles": {},
          "text": "相对时间：",
          "type": "text"
        },
        {
          "styles": {
            "code": true
          },
          "text": "d",
          "type": "text"
        },
        {
          "styles": {},
          "text": "/",
          "type": "text"
        },
        {
          "styles": {
            "code": true
          },
          "text": "w",
          "type": "text"
        },
        {
          "styles": {},
          "text": "/",
          "type": "text"
        },
        {
          "styles": {
            "code": true
          },
          "text": "M",
          "type": "text"
        },
        {
          "styles": {},
          "text": "/",
          "type": "text"
        },
        {
          "styles": {
            "code": true
          },
          "text": "y",
          "type": "text"
        },
        {
          "styles": {},
          "text": "，",
          "type": "text"
        },
        {
          "styles": {
            "code": true
          },
          "text": "<n><unit>recent:7d",
          "type": "text"
        },
        {
          "styles": {},
          "text": "、",
          "type": "text"
        },
        {
          "styles": {
            "code": true
          },
          "text": "recent:1Mhas",
          "type": "text"
        },
        {
          "styles": {},
          "text": "布尔标志：",
          "type": "text"
        },
        {
          "styles": {
            "code": true
          },
          "text": "assets",
          "type": "text"
        },
        {
          "styles": {},
          "text": " / ",
          "type": "text"
        },
        {
          "styles": {
            "code": true
          },
          "text": "scheduled",
          "type": "text"
        },
        {
          "styles": {},
          "text": " / ",
          "type": "text"
        },
        {
          "styles": {
            "code": true
          },
          "text": "comment",
          "type": "text"
        },
        {
          "styles": {},
          "text": " / ",
          "type": "text"
        },
        {
          "styles": {
            "code": true
          },
          "text": "locationhas:assetscomment",
          "type": "text"
        },
        {
          "styles": {},
          "text": "备注子串匹配。",
          "type": "text"
        },
        {
          "styles": {
            "bold": true
          },
          "text": "默认字段",
          "type": "text"
        },
        {
          "styles": {},
          "text": "——不写字段名时即此",
          "type": "text"
        },
        {
          "styles": {
            "code": true
          },
          "text": "comment:晚餐",
          "type": "text"
        },
        {
          "styles": {},
          "text": " 或 直接写 ",
          "type": "text"
        },
        {
          "styles": {
            "code": true
          },
          "text": "晚餐",
          "type": "text"
        }
