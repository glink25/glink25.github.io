      "content": [
        {
          "styles": {},
          "text": "q:晚餐 amount:>100        # 隐式 AND：备注含\"晚餐\" 且 金额>100\nq:(tag:旅行 OR tag:出差) AND -has:scheduled\nq:!type:income            # 不是收入\n",
