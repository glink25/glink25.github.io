    {
      "children": [],
      "content": [
        {
          "styles": {},
          "text": "<!-- reactive -->\n<div class=\"box\">\n\t<div class=\"content\">Hover me</div>\n\t<div class=\"tooltip\">Tooltip</div>\n</div>\n<style>\n.box {\n\tposition: relative;\n}\n.tooltip {\n\tposition: absolute;\n\topacity: 0;\n\ttransition: all ease 0.2s;\n\tbox-shadow: 0 1px 1px black;\n\tborder-radius: 4px;\n\tpadding: 2px 4px;\n}\n.box:hover .tooltip {\n\topacity: 1;\n}\n</style>",
          "type": "text"
        }
      ],
      "id": "post_8dce7c1a6d048ee05068187a_b42",
